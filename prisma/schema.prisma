// ESAINA — PRD bagian 8 (Data, hak akses, dan riwayat)
// Semua mutasi bawa versi (expected_version) -> 409 saat konflik.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

enum AssessmentStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
}

enum GradeStatus {
  DRAFT
  FINAL
}

enum GradeSource {
  MANUAL
  AI
}

enum AuditAction {
  SUBMIT
  APPLY_AI
  CHANGE_GRADE
  APPROVE
  PUBLISH
  DELETE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  identifier   String?  // NIP guru / NIS siswa
  isActive     Boolean  @default(true)
  anonCode     String   @unique @default(cuid()) // kode anonim untuk LLM, bukan nama/email
  createdAt    DateTime @default(now())

  taughtClasses     Class[]           @relation("ClassTeacher")
  memberships       ClassMembership[] @relation("MembershipStudent")
  submissions       Submission[]
  gradeRevisions    GradeRevision[]   @relation("GradeAuthor")
  approvedRevisions GradeRevision[]   @relation("GradeApprovedBy")
  publications      Publication[]
  aiResults         AIResult[]
  auditEvents       AuditEvent[]
}

model Class {
  id         String   @id @default(cuid())
  name       String
  joinCode   String   @unique
  teacherId  String
  createdAt  DateTime @default(now())

  teacher     User         @relation("ClassTeacher", fields: [teacherId], references: [id])
  memberships ClassMembership[]
  assessments Assessment[]

  @@index([teacherId])
}

model ClassMembership {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation("MembershipStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model Assessment {
  id          String           @id @default(cuid())
  classId     String
  title       String
  instruction String
  status      AssessmentStatus @default(DRAFT)
  durationMinutes Int             @default(60) // 0 = tanpa batas waktu
  version     Int              @default(1)
  openedAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime         @default(now())

  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]
  publications Publication[]

  @@index([classId])
}

model Question {
  id              String   @id @default(cuid())
  assessmentId    String
  order           Int
  text            String
  referenceAnswer String // acuan: tidak pernah dikirim ke siswa
  maxScore        Int
  createdAt       DateTime @default(now())

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]
  answers    Answer[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
}

model RubricCriterion {
  id           String @id @default(cuid())
  questionId   String
  code         String // C1, C2, ...
  description  String
  minScore     Int
  maxScore     Int
  levels       Json // level/rentang skor untuk bimbingan penilaian
  order        Int

  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradeItems GradeItem[]

  @@unique([questionId, code])
  @@index([questionId])
}

model Submission {
  id            String           @id @default(cuid())
  assessmentId  String
  studentId     String
  status        SubmissionStatus @default(IN_PROGRESS)
  version       Int              @default(1) // versi draft answers
  submittedAt   DateTime?
  createdAt     DateTime         @default(now())

  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    Answer[]
  aiResults  AIResult[]
  gradeRevisions GradeRevision[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId, status])
}

model Answer {
  id           String   @id @default(cuid())
  submissionId String
  questionId   String
  content      String   @db.Text
  version      Int      @default(1)
  savedAt      DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

model AIResult {
  id             String   @id @default(cuid())
  submissionId   String
  requestedById  String
  provider       String
  model          String
  promptVersion  String
  cacheKey       String
  sourceVersion  Int // versi submission saat request
  payload        Json // hasil per kriteria (question_id, criterion_id, score, evidence, rationale, feedback)
  validationOk   Boolean
  validationMsg  String?
  tokenUsed      Int?
  attemptedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedBy  User           @relation(fields: [requestedById], references: [id])
  appliedItems GradeItem[]

  @@index([submissionId, cacheKey])
  @@index([submissionId, createdAt(sort: Desc)])
}

model GradeRevision {
  id            String      @id @default(cuid())
  submissionId  String
  authorId      String
  approvedById  String?
  status        GradeStatus @default(DRAFT)
  version       Int         @default(1) // versi revisi nilai
  totalScore    Int         @default(0)
  createdAt     DateTime    @default(now())
  approvedAt    DateTime?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation("GradeAuthor", fields: [authorId], references: [id])
  approvedBy User?      @relation("GradeApprovedBy", fields: [approvedById], references: [id])
  items      GradeItem[]
  publications Publication[]

  @@index([submissionId, status])
  @@index([submissionId, version])
}

model GradeItem {
  id            String      @id @default(cuid())
  revisionId    String
  questionId    String
  criterionId   String
  score         Int?
  feedback      String      @db.Text
  source        GradeSource @default(MANUAL)
  aiResultId    String? // ID draf AI yang diterapkan
  createdAt     DateTime    @default(now())

  revision  GradeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  aiResult  AIResult?     @relation(fields: [aiResultId], references: [id])

  @@unique([revisionId, questionId, criterionId])
  @@index([criterionId])
}

model Publication {
  id            String   @id @default(cuid())
  assessmentId  String
  revisionId    String
  publishedById String
  publishedAt   DateTime @default(now())

  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  revision     GradeRevision @relation(fields: [revisionId], references: [id])
  publishedBy  User          @relation(fields: [publishedById], references: [id])

  @@unique([revisionId]) // satu revisi terbit sekali
  @@index([assessmentId])
}

model AuditEvent {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  entityType String // "Submission" | "GradeRevision" | ...
  entityId   String
  versionBefore Int?
  versionAfter  Int?
  createdAt  DateTime    @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}

model IdempotencyKey {
  key       String   @id
  userId    String
  scope     String // "submit" | "approve" | "publish"
  createdAt DateTime @default(now())

  @@index([userId, scope])
}
